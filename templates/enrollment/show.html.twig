{% extends 'base.html.twig' %}

{% block title %}Detalle de matrícula | LearnHub{% endblock %}

{% block body %}

    <h1>Detalle de matrícula</h1>

    <table class="table">
        <tbody>
        <tr>
            <th>Id</th>
            <td>{{ enrollment.id }}</td>
        </tr>

        <tr>
            <th>Alumno/a</th>
            <td>{{ enrollment.studentName }}</td>
        </tr>

        <tr>
            <th>Email</th>
            <td>{{ enrollment.studentEmail }}</td>
        </tr>

        <tr>
            <th>Curso</th>
            <td>{{ enrollment.course.title }}</td>
        </tr>

        <tr>
            <th>Estado</th>
            <td>{{ enrollment.status }}</td>
        </tr>
        </tbody>
    </table>

    <a class="back-link" href="{{ path('app_enrollment_index') }}">
        Volver a matrículas
    </a>

    {% if app.user %}
        <a class="edit-button"
           href="{{ path('app_enrollment_edit', {'id': enrollment.id}) }}">
            Editar
        </a>

        {{ include('enrollment/_delete_form.html.twig') }}
    {% endif %}

{% endblock %}
