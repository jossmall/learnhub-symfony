{% extends 'base.html.twig' %}

{% block title %}Iniciar sesión | LearnHub{% endblock %}

{% block body %}

    <h1>Iniciar sesión</h1>

    {% if error %}
        <div class="alert">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    {% if app.user %}
        <p>
            Has iniciado sesión como {{ app.user.userIdentifier }}.
            <a href="{{ logout_path() }}">Cerrar sesión</a>
        </p>
    {% endif %}

    <form method="post">

        <label for="username">Email</label>
        <input
            type="email"
            value="{{ last_username }}"
            name="_username"
            id="username"
            autocomplete="email"
            required
            autofocus
        >

        <label for="password">Contraseña</label>
        <input
            type="password"
            name="_password"
            id="password"
            autocomplete="current-password"
            required
        >

        <input
            type="hidden"
            name="_csrf_token"
            data-controller="csrf-protection"
            value="{{ csrf_token('authenticate') }}"
        >

        <button class="btn" type="submit">
            Iniciar sesión
        </button>

    </form>

    <a class="back-link" href="{{ path('app_home') }}">
        Volver al inicio
    </a>

{% endblock %}
